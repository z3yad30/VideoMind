.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.vscode/

# Frontend dependencies and build output
node_modules/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/.env
frontend/.env.*
!frontend/.env.example

# Local runtime data
/data/videos/*
/data/audio/*
/data/transcripts/*
/data/summaries/*
/data/chroma/*

# Keep the runtime data directories in the project tree
!/data/videos/.gitkeep
!/data/audio/.gitkeep
!/data/transcripts/.gitkeep
!/data/summaries/.gitkeep
!/data/chroma/.gitkeep
