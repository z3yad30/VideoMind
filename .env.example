# Runtime and persistence
DATABASE_URL=sqlite:///data/videomind.db
SQLITE_BUSY_TIMEOUT_MS=5000
WORKER_MODE=embedded
MAX_CONCURRENT_JOBS=1
APP_ENV=development
# Leave empty to default to false locally and true when APP_ENV=production.
COOKIE_SECURE=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limits
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=5/minute
INGESTION_RATE_LIMIT=10/hour
QUESTION_RATE_LIMIT=30/minute

# AI services
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ASR_MODEL=base
# Use cuda with an NVIDIA GPU and compatible CUDA/cuDNN runtime; otherwise keep cpu.
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# Logging
LOG_LEVEL=INFO

# Ingestion limits and media tools
MAX_UPLOAD_BYTES=2147483648
MAX_MEDIA_DURATION_SECONDS=7200
MAX_VIDEOS_PER_USER=100
MAX_TOTAL_MINUTES_PER_USER=6000
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
SUBPROCESS_TIMEOUT_SECONDS=1800
MAX_QUESTION_CHARACTERS=2000
